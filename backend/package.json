{
  "name": "autorent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de AutoRent con Express, TypeScript y MySQL",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "auth:setup": "node scripts/setup-auth-secret.mjs",
    "user:promote": "tsx src/scripts/promote-user.ts",
    "fleet:import": "tsx src/scripts/import-real-fleet.ts"
    ,"db:migrate": "node scripts/migrate.mjs"
    ,"test:integration": "node scripts/verify-operations.mjs"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
